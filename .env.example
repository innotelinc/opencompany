# ---------------------------------------------------------------------------
# OpenCompany — environment template. Copy to .env and fill in what you need.
# Never commit .env. Secrets stay on the server; they are never sent to the UI.
# ---------------------------------------------------------------------------

# SQLite database file (default) or a PostgreSQL URL once the Postgres adapter
# is enabled. The default path is created automatically.
OPENCOMPANY_DB=.data/opencompany.db

# Where employee workspaces, deliverable artifacts and local previews live.
OPENCOMPANY_DATA_DIR=.data

# Owner identity used by the single-company development install.
OPENCOMPANY_OWNER_EMAIL=owner@northwind-studio.test
OPENCOMPANY_COMPANY_SLUG=northwind-studio

# ---------------------------------------------------------------------------
# Agent backend
#   deterministic = offline, deterministic, clearly labelled SIMULATED work.
#                   Real files, real checks, no model calls, no cost.
#   llm           = real agent work through an OpenAI-compatible chat API.
# ---------------------------------------------------------------------------
OPENCOMPANY_AGENT_BACKEND=deterministic

# OpenAI-compatible endpoint used by the llm backend and by CopilotKit chat.
# Any compatible provider works (vLLM, Ollama's OpenAI API, OpenRouter, ...).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENCOMPANY_MODEL=gpt-4.1-mini

# Chat panel. Disabled automatically when OPENAI_API_KEY is empty.
NEXT_PUBLIC_CHAT_ENABLED=

# ---------------------------------------------------------------------------
# Limits. Defaults shown. All are enforced server-side.
# ---------------------------------------------------------------------------
# 0 means no ceiling: usage is still recorded, but never reported as an overrun.
OPENCOMPANY_MONTHLY_BUDGET_CENTS=2500
OPENCOMPANY_AUTO_APPROVE_CENTS=300
OPENCOMPANY_MAX_DELEGATION_DEPTH=3
OPENCOMPANY_MAX_REVIEW_ROUNDS=2
OPENCOMPANY_MAX_ATTEMPTS=2
OPENCOMPANY_RUN_TIMEOUT_SECONDS=600
OPENCOMPANY_RUN_LEASE_SECONDS=120
OPENCOMPANY_WORKER_POLL_MS=1500

# Browser sessions run only inside the employee workspace. The image installs
# Playwright's Chromium; set this to 0 to keep employee browsing off entirely.
OPENCOMPANY_BROWSER_ENABLED=1

# ---------------------------------------------------------------------------
# Public site. The company's own site is served at /site; this URL is what the
# availability routine and /api/public-site/health check (default: this app).
# ---------------------------------------------------------------------------
OPENCOMPANY_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Public deployment provider (optional). Without it, an approved deployment is
# packaged locally and reported as blocked — nothing is published.
#   coolify = default. Triggers a deployment of a pre-created Coolify
#             application through its REST API and checks the public URL.
#   vercel  = uploads the artifact files through Vercel's REST API.
# The worker only deploys artifacts whose approval hash still matches.
# Coolify token: Coolify → Keys & Tokens → API tokens (never commit it).
# ---------------------------------------------------------------------------
OPENCOMPANY_DEPLOY_PROVIDER=coolify
COOLIFY_BASE_URL=https://deploy.innotel.us
COOLIFY_TOKEN=
COOLIFY_APP_UUID=
OPENCOMPANY_DEPLOY_NAME=opencompany-site

# Only used when OPENCOMPANY_DEPLOY_PROVIDER=vercel.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
