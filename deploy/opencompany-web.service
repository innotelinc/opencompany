[Unit]
Description=OpenCompany web (Next.js)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/opencompany
EnvironmentFile=/opt/opencompany/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start -- -p 3000 -H 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
